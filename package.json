{
  "name": "corner-smoothie",
  "version": "0.1.5",
  "description": "Create elements with Figma corner smoothing",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./worklet": "./dist/worklet.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint --fix './**/*.{js,ts}'",
    "lint:ci": "eslint --max-warnings 0 './**/*.{js,ts}'",
    "prepack": "tsdown",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyanSalt/corner-smoothie.git"
  },
  "keywords": [
    "corner-smoothing",
    "css",
    "houdini"
  ],
  "author": "CyanSalt",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CyanSalt/corner-smoothie/issues"
  },
  "homepage": "https://github.com/CyanSalt/corner-smoothie#readme",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "error"
    },
    "packageManager": [
      {
        "name": "pnpm",
        "version": "^11.0.0",
        "onFail": "error"
      },
      {
        "name": "npm",
        "onFail": "ignore"
      }
    ]
  },
  "devDependencies": {
    "@cyansalt/eslint-config": "^4.6.0",
    "@cyansalt/tsconfig": "^3.0.2",
    "@release-it/conventional-changelog": "^11.0.0",
    "eslint": "^10.3.0",
    "release-it": "^20.0.1",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "draw-svg-path": "^2.0.1",
    "figma-squircle": "^1.1.0"
  }
}
